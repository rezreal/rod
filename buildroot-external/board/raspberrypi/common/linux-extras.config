# Kernel config fragment applied on top of the board defconfig.
# Only adds what the RPi defconfigs don't guarantee by default.

# USB-to-serial adapters for /dev/ttyUSB0 (Modbus RTU to IAI)
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_ACM=m

# Bluetooth UART attachment (BCM chip on /dev/ttyAMA0)
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_BCM=y

# No userspace anywhere in this image touches ALSA or the camera stack
# (no wpa_supplicant/ALSA-utils/camera app either, but WiFi and DRM/fbcon
# stay on: WiFi for a future provisioning path, DRM for a local HDMI
# console). Disabling the umbrella symbols cascades off every driver
# underneath — sound cards, camera/V4L2/UNICAM/ISP — cutting real kernel
# build time since none of it compiles at all.
# CONFIG_SOUND is not set
# CONFIG_MEDIA_SUPPORT is not set
